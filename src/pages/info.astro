---
// Página Info (como /info de segerman.dev): quién soy, qué hago, cómo trabajo y contacto.
// TODO: los textos son un borrador; reescríbelos con tu voz.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Background from '../components/Background.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { studio, whatsappLink, withBase } from '../data/studio';
import { theme } from '../data/theme';
import credits from '../data/credits.json';

const quote =
  whatsappLink('Hola Javier, quiero cotizar una landing para mi negocio.') ||
  `mailto:${studio.email}?subject=${encodeURIComponent('Cotización de landing')}`;

const incluye = [
  'Diseño a la medida, pensado primero para celular',
  'Botón de WhatsApp para recibir clientes',
  'Ubicación con Google Maps y horarios',
  'Galería de fotos de tus trabajos',
  'Subdominio tunegocio.esdetarapaca.cl',
  'Hosting incluido y certificado HTTPS',
];

const herramientas = ['Astro', 'TypeScript', 'Angular', 'NestJS', 'Docker', 'GitHub Actions'];

const pasos = [
  { n: '01', title: 'Conversamos', text: 'Me cuentas de tu negocio y qué quieres que la gente haga: reservar, llamar o llegar a tu local.' },
  { n: '02', title: 'Diseño', text: 'Te muestro una primera versión con tus fotos, tus precios y tu estilo. La ajustamos juntos.' },
  { n: '03', title: 'Publicación', text: 'Tu página queda en línea en su subdominio, rápida en el celular y lista para Google.' },
  { n: '04', title: 'Acompañamiento', text: 'Si cambias un precio, un horario o quieres sumar fotos, me escribes y lo actualizo.' },
];
---

<Layout title={`Info | ${studio.owner}`} description="Quién soy, qué incluye una landing y cómo trabajo.">
  <Background dim />
  <Header back />

  <main id="contenido" class="info" tabindex="-1">
    <section class="about">
      <figure class="portrait reveal" style="--d: 0.4s">
        <img src={withBase('/img/javier.webp')} alt={studio.owner} width="588" height="721" decoding="async" />
      </figure>
      <div class="about-text">
        <h1 class="about-title mask-line" style="--d: 0.45s"><span>Sobre mí</span></h1>
        <p class="name reveal" style="--d: 0.6s">{studio.owner} · {studio.role}</p>
        <div class="bio reveal" style="--d: 0.7s">
          <p>
            Soy Javier, desarrollador de software de Alto Hospicio. Estudié Ingeniería en Informática en la Universidad
            Técnica Federico Santa María y hoy trabajo como Analista de Soporte TI y Software en Intermex, en la ZOFRI de
            Iquique.
          </p>
          <p>
            Fuera del trabajo administro mi propio servidor, un homelab con Ubuntu Server, Docker y GitHub Actions, donde
            pruebo todo lo que después uso en mis proyectos.
          </p>
          <p>
            En <b>{studio.domain}</b> hago landings para negocios de Tarapacá: barberías, restaurantes, talleres y tiendas
            que quieren que los encuentren y les escriban.
          </p>
        </div>
      </div>
    </section>

    <section class="cols reveal" style="--d: 0.7s">
      <div>
        <h2 class="label">Toda landing incluye</h2>
        <ul class="list">
          {incluye.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="label">Cómo trabajo</h2>
        <ol class="steps">
          {
            pasos.map((p) => (
              <li>
                <span class="n">{p.n}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h2 class="label">Herramientas</h2>
        <p class="tools">{herramientas.join(', ')}</p>
        <h2 class="label spaced">Contacto</h2>
        <ul class="list plain">
          <li><CopyEmail /></li>
          {studio.whatsapp && <li><a class="link" href={quote}>WhatsApp</a></li>}
          {studio.instagram && <li><a class="link" href={studio.instagram} target="_blank" rel="me noopener">Instagram {studio.instagramHandle}</a></li>}
          {studio.linkedin && <li><a class="link" href={studio.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a></li>}
          {studio.github && <li><a class="link" href={studio.github} target="_blank" rel="me noopener">GitHub ↗</a></li>}
        </ul>
        <h2 class="label spaced">Disponible</h2>
        <p>{studio.availableFrom}</p>
        <a class="cta" href={quote}>Cotiza tu landing →</a>
      </div>
    </section>

    <footer class="foot">
      <div>
        <h2 class="label">Fotos (Wikimedia Commons)</h2>
        <ul class="credits">
          {
            credits.map((c) => (
              <li>
                <a class="link" href={c.source} target="_blank" rel="noopener">
                  {c.author}
                </a>{' '}
                · <a class="link" href={c.licenseUrl} target="_blank" rel="noopener license">{c.license}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="copy">© {new Date().getFullYear()} {studio.domain} · Edición {theme.edition}</p>
    </footer>
  </main>
</Layout>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 120px var(--unit) var(--unit);
    outline: none;
  }
  .about {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(260px, 30%) 1fr;
      gap: 56px;
      align-items: end;
    }
  }
  .portrait img {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .about-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-transform);
    letter-spacing: var(--display-tracking);
    line-height: var(--display-leading);
    font-size: clamp(56px, 10vw, 150px);
  }
  /* espacio arriba para la tilde de "MÍ", que la máscara recortaba */
  .about-title.mask-line {
    padding-top: 0.2em;
  }
  .name {
    margin-top: 18px;
    font-weight: 600;
    color: var(--accent);
  }
  .bio {
    margin-top: 20px;
    max-width: 58ch;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.45;
  }
  .bio b {
    color: var(--accent);
  }
  .tools {
    color: var(--ink-2);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 48px 40px;
    font-size: 16px;
  }
  .label {
    margin-bottom: 14px;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 400;
    opacity: 0.55;
  }
  .label.spaced {
    margin-top: 28px;
  }
  .list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .list:not(.plain) li::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 3px;
    margin-right: 10px;
    vertical-align: middle;
    background: var(--mark);
  }
  .list a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
  }
  .steps {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .steps li {
    display: flex;
    gap: 14px;
  }
  .n {
    font-size: 13px;
    opacity: 0.5;
    padding-top: 3px;
  }
  .steps h3 {
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .steps p {
    color: var(--ink-2);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 24px;
    padding: 0 22px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background-color 0.2s ease;
  }
  .cta:hover {
    background: var(--accent);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    font-size: 13px;
  }
  .credits {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--ink-2);
  }
  .copy {
    color: var(--muted);
  }
</style>
