---
// Inicio con la estructura de segerman.dev: nombre pequeño, título gigante, carrusel infinito,
// índice a la derecha y contacto / disponibilidad abajo. Lo de Tarapacá va en el fondo (día / noche).
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Background from '../components/Background.astro';
import Carousel from '../components/Carousel.astro';
import CopyEmail from '../components/CopyEmail.astro';
import { studio } from '../data/studio';
import { theme } from '../data/theme';
---

<Layout
  title={`${studio.owner} | Software Developer`}
  description="Software developer en Alto Hospicio. Landings para negocios de Tarapacá: rápidas, a tu medida y listas para recibir clientes."
  stage
>
  <Background />
  <Header />

  <main id="contenido" class="page" tabindex="-1">
    <div class="text-wrapper">
      <h1 class="headline">
        <span class="line">Software</span>
        <span class="line">Developer</span>
      </h1>
      <p class="text">{theme.tagline}</p>
    </div>

    <Carousel />

    <div class="metas">
      <dl class="meta">
        <dt class="label">Contacto</dt>
        <dd><CopyEmail /></dd>
      </dl>
      <dl class="meta">
        <dt class="label">Disponible</dt>
        <dd>{studio.availableFrom}</dd>
      </dl>
    </div>

    <p class="corner">
      <span class="day">{theme.caption.day}</span>
      <span class="night">{theme.caption.night}</span>
      <span class="copy">© {new Date().getFullYear()}</span>
    </p>
  </main>
</Layout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-height: 100dvh;
    padding-top: 96px;
    padding-bottom: var(--unit);
    outline: none;
  }
  .text-wrapper {
    padding: 0 var(--unit);
  }
  .headline {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    text-transform: var(--display-transform);
    line-height: var(--display-leading);
    letter-spacing: var(--display-tracking);
    font-size: clamp(56px, 15vw, 96px);
  }
  .line {
    display: block;
  }
  .line:nth-child(2) {
    font-style: var(--line2-style, normal);
    color: var(--line2-color, inherit);
  }
  .text {
    margin-top: 20px;
    max-width: 30rem;
    font-size: 17px;
    line-height: 1.34;
    color: var(--ink-2);
  }
  .metas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    padding: 0 var(--unit);
    margin-top: auto;
  }
  .meta {
    font-size: 15px;
  }
  .label {
    margin-bottom: 4px;
    opacity: 0.5;
  }
  .corner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--unit);
    font-size: 13px;
    color: var(--muted);
  }
  .corner .copy {
    margin-left: auto;
  }

  @media (min-width: 900px) and (min-height: 600px) {
    :global(html.stage),
    :global(html.stage body) {
      height: 100%;
      overflow: hidden;
    }
    /* Columna: texto arriba, carrusel en el espacio que sobra, contacto abajo. */
    .page {
      position: relative;
      height: 100dvh;
      min-height: 0;
      gap: 32px;
      padding: 84px 0 84px;
    }
    .text-wrapper {
      flex: 0 0 auto;
      padding-right: calc(220px + var(--unit) * 2);
    }
    .headline {
      font-size: var(--headline-size, clamp(64px, min(10.5vw, 17dvh), 176px));
    }
    .line:nth-child(2) {
      margin-left: var(--line2-indent, 0.62em);
    }
    .text {
      max-width: 34rem;
      font-size: 18px;
    }
    .metas {
      position: absolute;
      left: 0;
      bottom: var(--unit);
      margin: 0;
    }
    .corner {
      position: absolute;
      right: 0;
      bottom: var(--unit);
      padding-right: var(--unit);
    }
    .corner .copy {
      margin-left: 24px;
    }
  }
</style>
